-- SERVER HOP
local Hopping = false

Hop.Activated:Connect(function()
    if Hopping then return end

    Hopping = true
    Hop.Text = "HOPPING..."

    local Success, Error = pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)

    if not Success then
        warn("JADENHUB:", Error)
        Hop.Text = "FAILED - RETRY"
        task.wait(2)
        Hop.Text = "SERVER HOP"
        Hopping = false
    end
end)

-- DRAGGABLE MAIN CIRCLE
local Dragging = false
local DragStart
local StartPos
local Moved = false
local DragInput

Main.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        Moved = false
        DragStart = Input.Position
        StartPos = Main.Position
        DragInput = Input
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and (
        Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch
    ) then

        local Delta = Input.Position - DragStart

        if Delta.Magnitude > 5 then
            Moved = true
        end

        Main.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + Delta.Y
        )

        -- Keep panels beside the circle
        Frame.Position = UDim2.new(
            Main.Position.X.Scale,
            Main.Position.X.Offset + Size + 28,
            Main.Position.Y.Scale,
            Main.Position.Y.Offset + Size/2 - 21
        )

        Settings.Position = UDim2.new(
            Frame.Position.X.Scale,
            Frame.Position.X.Offset,
            Frame.Position.Y.Scale,
            Frame.Position.Y.Offset + 48
        )
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input == DragInput then
        Dragging = false
        DragInput = nil
    end
end)

-- MAIN TOGGLE
Main.Activated:Connect(function()
    if not Moved then
        Frame.Visible = not Frame.Visible
        Settings.Visible = false
    end
end)

